@inherits LayoutComponentBase

<div class="shell">
    <header class="topbar">
        <div class="tb-brand">
            <div class="tb-logo">
                <div class="tb-logo-seg" style="background:var(--met)"></div>
                <div class="tb-logo-seg" style="background:var(--l1)"></div>
                <div class="tb-logo-seg" style="background:var(--l2)"></div>
                <div class="tb-logo-text">LimaTap</div>
            </div>
            <div class="tb-tagline">Sistema Integrado de Transporte Público · Lima Metropolitana</div>
        </div>
        <div class="tb-center">
            <div class="tb-status">
                <div class="s-dot" style="background:var(--met)"></div>
                <span style="color:var(--met);font-weight:700">Metropolitano</span> operativo
            </div>
            <div class="tb-status">
                <div class="s-dot" style="background:var(--l1)"></div>
                <span style="color:var(--l1);font-weight:700">Línea 1</span> operativa
            </div>
            <div class="tb-status">
                <div class="s-dot" style="background:var(--l2);animation:none"></div>
                <span style="color:var(--l2-dark);font-weight:700">Línea 2</span> en construcción
            </div>
        </div>
        <div class="tb-right">
            <div class="ib" title="Notificaciones">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
            </div>
            <div class="user-chip">
                <div class="u-av">CL</div>
                <div class="u-name">Carlos López</div>
            </div>
        </div>
    </header>

    <div class="mob-header">
        <div class="mh-row">
            <div>
                <div class="mh-title">Hola, Carlos 👋</div>
                <div class="mh-sub">LimaTap · Tarjeta activa</div>
            </div>
            <div style="display:flex;gap:8px;align-items:center">
                <div class="ib" style="width:32px;height:32px">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                </div>
                <div class="mh-av">CL</div>
            </div>
        </div>
    </div>

    <NavMenu />

    <main class="main">
        @Body
    </main>
</div>