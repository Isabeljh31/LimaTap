@page "/profile"

<div class="tab-panel active">
    <div class="ph">
        <div>
            <div class="ph-title">Mi perfil</div>
            <div class="ph-sub">Gestiona tu cuenta, seguridad y preferencias</div>
        </div>
        <button class="btn btn-outline">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
            Editar perfil
        </button>
    </div>

    <div class="perfil-grid">
        <div style="display:flex;flex-direction:column;gap:1rem">
            <div class="pcard">
                <div class="p-banner"></div>
                <div class="p-body">
                    <div class="p-av-wrap"><div class="p-av">CL</div></div>
                    <div class="p-name">Carlos López</div>
                    <div class="p-email">carlos.lopez@gmail.com</div>
                    <div class="p-badges">
                        <div class="p-badge" style="background:var(--met-light);border:1px solid var(--met-mid);color:var(--met)">Tarjeta activa</div>
                        <div class="p-badge" style="background:var(--l2-light);border:1px solid var(--l2-mid);color:var(--l2-dark)">★ Viajero frecuente</div>
                    </div>
                    <div class="p-info-row"><span class="pi-lbl">DNI</span><span class="pi-val">••••••••</span></div>
                    <div class="p-info-row"><span class="pi-lbl">Teléfono</span><span class="pi-val">+51 9•• ••• 892</span></div>
                    <div class="p-info-row"><span class="pi-lbl">N.° tarjeta</span><span class="pi-val">•••• 7823</span></div>
                    <div class="p-info-row"><span class="pi-lbl">Miembro desde</span><span class="pi-val">Mar 2024</span></div>
                </div>
            </div>
            <div>
                <div class="sec-label">Billeteras digitales</div>
                <div class="wallets-row">
                    <div class="w-card">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--text2)" stroke-width="1.5"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15v-4H7l5-8v4h4l-5 8z" /></svg>
                        <div class="w-label">Apple Wallet</div>
                        <div class="w-linked">● Vinculada</div>
                    </div>
                    <div class="w-card">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--text3)" stroke-width="1.5"><circle cx="12" cy="12" r="10" /><path d="M12 8v8M8 12h8" /></svg>
                        <div class="w-label">Google Wallet</div>
                        <div class="w-unlinked">Vincular</div>
                    </div>
                </div>
            </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:1rem">
            <div class="settings-group">
                <div class="sg-header">Notificaciones</div>
                <div class="srow" @onclick="ToggleTravelAlerts">
                    <div class="s-ico" style="background:var(--met-light)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--met)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg></div>
                    <div style="flex:1"><div class="s-name">Alertas de viaje</div><div class="s-desc">Confirmación de validación NFC</div></div>
                    <div class="toggle @(TravelAlerts ? "on" : "off")"></div>
                </div>
                <div class="srow" @onclick="ToggleLowBalanceAlerts">
                    <div class="s-ico" style="background:var(--l2-light)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--l2-dark)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg></div>
                    <div style="flex:1"><div class="s-name">Alerta de saldo bajo</div><div class="s-desc">Avisar cuando saldo &lt; S/ 5.00</div></div>
                    <div class="toggle @(LowBalanceAlerts ? "on" : "off")"></div>
                </div>
                <div class="srow" @onclick="TogglePromoAlerts">
                    <div class="s-ico" style="background:var(--bg3)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--text3)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg></div>
                    <div style="flex:1"><div class="s-name">Promociones y ofertas</div><div class="s-desc">Descuentos y beneficios especiales</div></div>
                    <div class="toggle @(PromoAlerts ? "on" : "off")"></div>
                </div>
            </div>

            <div class="settings-group">
                <div class="sg-header">Seguridad y acceso</div>
                <div class="srow" @onclick="ToggleBiometrics">
                    <div class="s-ico" style="background:var(--l1-light)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--l1)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg></div>
                    <div style="flex:1"><div class="s-name">Autenticación biométrica</div><div class="s-desc">Huella o Face ID para abrir app</div></div>
                    <div class="toggle @(Biometrics ? "on" : "off")"></div>
                </div>
                <div class="srow">
                    <div class="s-ico" style="background:var(--bg3)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--text2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg></div>
                    <div style="flex:1"><div class="s-name">Cambiar PIN de seguridad</div><div class="s-desc">Última actualización: hace 3 meses</div></div>
                    <div class="s-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg></div>
                </div>
                <div class="srow">
                    <div class="s-ico" style="background:var(--met-light)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--met)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" /><line x1="1" y1="10" x2="23" y2="10" /></svg></div>
                    <div style="flex:1"><div class="s-name">Bloquear tarjeta</div><div class="s-desc">Bloqueo inmediato por pérdida o robo</div></div>
                    <div class="s-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg></div>
                </div>
            </div>

            <div class="settings-group">
                <div class="sg-header">Soporte y app</div>
                <div class="srow">
                    <div class="s-ico" style="background:var(--bg3)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--text2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg></div>
                    <div style="flex:1"><div class="s-name">Centro de ayuda</div><div class="s-desc">FAQs y guías de uso</div></div>
                    <div class="s-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg></div>
                </div>
                <div class="srow">
                    <div class="s-ico" style="background:var(--bg3)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--text2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg></div>
                    <div style="flex:1"><div class="s-name">Reportar un problema</div></div>
                    <div class="s-arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg></div>
                </div>
                <div class="srow">
                    <div class="s-ico" style="background:#FEF0F0"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#D0392A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg></div>
                    <div style="flex:1"><div class="s-name" style="color:#D0392A">Cerrar sesión</div></div>
                    <div class="s-arrow" style="color:#D0392A"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg></div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // --- ESTADO DE LOS TOGGLES ---
    private bool TravelAlerts = true;
    private bool LowBalanceAlerts = true;
    private bool PromoAlerts = false;
    private bool Biometrics = false;

    private void ToggleTravelAlerts() => TravelAlerts = !TravelAlerts;
    private void ToggleLowBalanceAlerts() => LowBalanceAlerts = !LowBalanceAlerts;
    private void TogglePromoAlerts() => PromoAlerts = !PromoAlerts;
    private void ToggleBiometrics() => Biometrics = !Biometrics;
}