@page "/recharge"
@inject TransitSystem.Frontend.Services.TransitApiService ApiService

<div class="tab-panel active">
    <div class="ph">
        <div>
            <div class="ph-title">Recargar saldo</div>
            <div class="ph-sub">Elige un monto y tu método de pago preferido</div>
        </div>
        <div style="background:var(--met-light);border:1px solid var(--met-mid);border-radius:13px;padding:10px 18px;text-align:right">
            <div style="font-size:10px;color:var(--met);text-transform:uppercase;letter-spacing:1px;font-weight:600;margin-bottom:2px">Saldo actual</div>
            <div style="font-size:20px;font-weight:800;color:var(--met);font-family:var(--mono)">S/ @CurrentBalance.ToString("F2")</div>
        </div>
    </div>

    <div class="recarga-grid">
        <div>
            <div class="sec-label">Selecciona un monto</div>
            <div class="amounts-grid">
                @foreach (var amt in PredefinedAmounts)
                {
                    <div class="amt-btn @(SelectedAmount == amt && !IsCustomAmount ? "sel" : "")" @onclick="() => SelectAmount(amt)">
                        <div class="amt-val">S/ @amt</div>
                        <div class="amt-hint">~@Math.Round(amt / CostPerTrip) viajes</div>
                    </div>
                }
            </div>

            <div style="font-size:11px;color:var(--text3);margin-bottom:7px;font-weight:500">O ingresa un monto personalizado</div>
            <div class="input-wrap">
                <span class="cur-lbl">S/</span>
                <input class="custom-in" type="number" placeholder="0.00" @bind="CustomAmount" @bind:event="oninput">
            </div>

            <div class="sec-label">Método de pago</div>
            <div id="methods">
                <div class="method-item @(SelectedMethod == "Yape" ? "active" : "")" @onclick="@(() => SelectMethod("Yape"))">
                    <div class="m-ico" style="background:var(--met-light)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--met)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" /><line x1="1" y1="10" x2="23" y2="10" /></svg>
                    </div>
                    <div style="flex:1"><div class="m-name">Yape</div><div class="m-desc">Pago instantáneo · Sin comisión</div></div>
                    <div class="radio @(SelectedMethod == "Yape" ? "on" : "off")">
                        @if (SelectedMethod == "Yape")
                        {
                            <div class="radio-dot"></div>
                        }
                    </div>
                </div>

                <div class="method-item @(SelectedMethod == "Plin" ? "active" : "")" @onclick="@(() => SelectMethod("Plin"))">
                    <div class="m-ico" style="background:var(--l1-light)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--l1)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" /><line x1="1" y1="10" x2="23" y2="10" /></svg>
                    </div>
                    <div style="flex:1"><div class="m-name">Plin</div><div class="m-desc">Pago instantáneo · Sin comisión</div></div>
                    <div class="radio @(SelectedMethod == "Plin" ? "on" : "off")">
                        @if (SelectedMethod == "Plin")
                        {
                            <div class="radio-dot"></div>
                        }
                    </div>
                </div>

                <div class="method-item @(SelectedMethod == "Tarjeta" ? "active" : "")" @onclick="@(() => SelectMethod("Tarjeta"))">
                    <div class="m-ico" style="background:var(--l2-light)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--l2-dark)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                    </div>
                    <div style="flex:1"><div class="m-name">Tarjeta débito / crédito</div><div class="m-desc">Visa, Mastercard · +0.5% comisión</div></div>
                    <div class="radio @(SelectedMethod == "Tarjeta" ? "on" : "off")">
                        @if (SelectedMethod == "Tarjeta")
                        {
                            <div class="radio-dot"></div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div>
            <div class="sec-label">Resumen de recarga</div>
            <div style="background:var(--surface); border:1.5px solid var(--border); border-radius:14px; padding:1.25rem; margin-bottom:1rem; text-align:center;">
                @if (SelectedMethod == "Yape" || SelectedMethod == "Plin")
                {
                    <div style="font-size:14px; font-weight:700; color:var(--text); margin-bottom:5px;">Escanea el código QR</div>
                    <div style="font-size:11px; color:var(--text3); margin-bottom: 10px;">Abre tu app de @SelectedMethod para transferir S/ @FinalAmount.ToString("F2")</div>
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=LimaTap-@(SelectedMethod)-@(FinalAmount)" alt="QR" style="border-radius:12px; border:1px solid var(--border);" />
                }
                else if (SelectedMethod == "Tarjeta")
                {
                    <div style="font-size:14px; font-weight:700; color:var(--text); margin-bottom:15px; text-align:left;">Datos de tu Tarjeta</div>
                    <input type="text" style="background:none; border:none; outline:none; font-size:14px; font-weight:600; color:var(--text); font-family:var(--mono); width:100%; border-bottom: 1px solid var(--border2); padding-bottom: 5px; margin-bottom: 15px;" placeholder="0000 0000 0000 0000" maxlength="16" />
                    <div style="display:flex; gap:10px; margin-bottom: 15px;">
                        <input type="text" style="background:none; border:none; outline:none; font-size:14px; font-weight:600; color:var(--text); font-family:var(--mono); width:100%; border-bottom: 1px solid var(--border2); padding-bottom: 5px;" placeholder="MM/AA" maxlength="5" />
                        <input type="password" style="background:none; border:none; outline:none; font-size:14px; font-weight:600; color:var(--text); font-family:var(--mono); width:100%; border-bottom: 1px solid var(--border2); padding-bottom: 5px;" placeholder="CVV" maxlength="4" />
                    </div>
                    <input type="text" style="background:none; border:none; outline:none; font-size:14px; font-weight:600; color:var(--text); font-family:var(--sans); width:100%; border-bottom: 1px solid var(--border2); padding-bottom: 5px;" placeholder="Nombre del titular" />
                }
            </div>
            <div class="summary-box">
                <div class="s-row"><span class="s-lbl">Monto a recargar</span><span class="s-val">S/ @FinalAmount.ToString("F2")</span></div>
                <div class="s-row"><span class="s-lbl">Método de pago</span><span class="s-val">@SelectedMethod</span></div>
                <div class="s-row"><span class="s-lbl">Comisión</span><span class="s-val" style="color:var(--l1)">S/ @Commission.ToString("F2")</span></div>
                <div class="s-div"></div>
                <div class="s-row"><span class="s-lbl" style="font-weight:700;color:var(--text)">Total a pagar</span><span class="s-total">S/ @TotalToPay.ToString("F2")</span></div>
            </div>

            <div class="projected-box">
                <div class="p-lbl">Saldo proyectado</div>
                <div class="p-val">S/ @ProjectedBalance.ToString("F2")</div>
                <div class="p-sub">≈ <span>@ProjectedTrips</span> viajes disponibles</div>
            </div>

            <button class="btn-recharge" @onclick="ProcessRecharge" disabled="@IsProcessing">
                @(IsProcessing ? "Procesando..." : $"Confirmar recarga · S/ {TotalToPay.ToString("F2")}")
            </button>

            @if (!string.IsNullOrEmpty(Message))
            {
                <div style="text-align:center;font-size:12px;color:var(--met);margin-top:10px;font-weight:bold;">@Message</div>
            }

            <div class="secure-note">🔒 Pago seguro · TLS 1.3 · PCI DSS v4.0</div>
        </div>
    </div>
</div>

@code {
    // --- ESTADO INICIAL ---
    private decimal CurrentBalance = 42.50m;
    private decimal CostPerTrip = 2.70m;

    private int[] PredefinedAmounts = { 10, 20, 30, 50, 100, 150 };
    private decimal SelectedAmount = 30m;
    private string SelectedMethod = "Yape";
    private bool IsCustomAmount = false;

    private string? _customAmountInput;
    private string? CustomAmount
    {
        get => _customAmountInput;
        set
        {
            _customAmountInput = value;
            if (decimal.TryParse(value, out var parsed))
            {
                SelectedAmount = parsed;
                IsCustomAmount = true;
            }
            else if (string.IsNullOrEmpty(value))
            {
                SelectedAmount = 0;
            }
        }
    }

    // --- CÁLCULOS DINÁMICOS ---
    private decimal FinalAmount => SelectedAmount;
    private decimal Commission => SelectedMethod == "Tarjeta" ? (FinalAmount * 0.005m) : 0m;
    private decimal TotalToPay => FinalAmount + Commission;
    private decimal ProjectedBalance => CurrentBalance + FinalAmount;
    private int ProjectedTrips => (int)Math.Round(ProjectedBalance / CostPerTrip);

    // --- MÉTODOS DE LA UI ---
    private void SelectAmount(decimal amount)
    {
        SelectedAmount = amount;
        IsCustomAmount = false;
        _customAmountInput = string.Empty;
    }

    private void SelectMethod(string method)
    {
        SelectedMethod = method;
    }

    // --- INTEGRACIÓN CON LA API ---
    private bool IsProcessing = false;
    private string Message = string.Empty;

    private async Task ProcessRecharge()
    {
        if (FinalAmount <= 0)
        {
            Message = "Ingresa un monto válido.";
            return;
        }

        IsProcessing = true;
        Message = string.Empty;

        // Simulamos el DTO que definiste en TransitSystem.Shared
        var request = new TransitSystem.Shared.Models.RechargeRequest
            {
                AccountId = "12345", // Hardcodeado por ahora
                Amount = FinalAmount,
                PaymentMethod = SelectedMethod,
                PaymentToken = "TOKEN_SEGURO_X"
            };

        // LLAMADA A LA API (Comentada temporalmente mientras encendemos la base de datos)
        // var response = await ApiService.RechargeAsync(request);

        // Simulación visual temporal:
        await Task.Delay(1500);
        CurrentBalance += FinalAmount;
        Message = "¡Recarga exitosa!";

        IsProcessing = false;
    }
}