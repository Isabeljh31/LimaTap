@page "/recarga-automatica"

<PageTitle>Recarga Automática - LimaTap</PageTitle>

<div class="recarga-auto-container">
    <h1>Recarga Automática</h1>
    <p class="subtitulo">Configura recargas automáticas para no quedarte sin saldo</p>

    <div class="saldo-actual">
        <span>Saldo disponible</span>
        <h2>S/ @saldoActual.ToString("0.00")</h2>
    </div>
    <div class="configuracion">
        <label>
            <input type="checkbox" @bind="config.Activa" />
            Activar recarga automática
        </label>

        @if (config.Activa)
        {
            <div class="campo">
                <label>Recargar cuando el saldo baje de:</label>
                <input type="number" @bind="config.MontoUmbral" step="1" /> soles
            </div>
            <div class="campo">
                <label>Monto a recargar:</label>
                <input type="number" @bind="config.MontoRecarga" step="5" /> soles
            </div>
            <button @onclick="GuardarConfiguracion">Guardar configuración</button>
            <p>@mensaje</p>
        }
    </div>
</div>

@code {
    private decimal saldoActual = 42.50m;
    private ConfiguracionRecarga config = new()
    {
        Activa = false,
        MontoUmbral = 10m,
        MontoRecarga = 30m
    };

    public class ConfiguracionRecarga
    {
        public bool Activa { get; set; }
        public decimal MontoUmbral { get; set; }
        public decimal MontoRecarga { get; set; }
    }
    private string mensaje = "";

    private void GuardarConfiguracion()
    {
        mensaje = $"Configuración guardada: recarga de S/ {config.MontoRecarga} cuando el saldo baje de S/ {config.MontoUmbral}";
    }
}