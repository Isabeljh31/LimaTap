@page "/help"
@using TransitSystem.Shared.Models
@inject HttpClient Http

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white d-flex align-items-center">
            <h5 class="mb-0"><i class="oi oi-warning me-2"></i> Central de Atención y Fricciones - LimaTap</h5>
        </div>
        <div class="card-body bg-light">
            <p class="text-muted">¿Tuviste algún inconveniente en las estaciones del Metropolitano o Línea 1? Reporta tu caso de inmediato para soporte técnico.</p>

            <div class="mb-3">
                <label class="form-label fw-bold">Número de Tarjeta LimaTap</label>
                <input type="text" class="form-control" @bind="issue.CardNumber" placeholder="Ej. MET-987654" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Estación del Incidente</label>
                <input type="text" class="form-control" @bind="issue.StationName" placeholder="Ej. Estación Central / Estación Angamos" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Servicio de Transporte</label>
                <select class="form-select" @bind="issue.SystemType">
                    <option value="Metropolitano">Metropolitano</option>
                    <option value="Linea 1">Línea 1 (Metro de Lima)</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Detalle de la Fricción o Reclamo</label>
                <textarea class="form-control" @bind="issue.Description" rows="3" placeholder="Describa brevemente el problema (ej: torniquete no leyó saldo, máquina de recarga falló)..."></textarea>
            </div>

            <button class="btn btn-danger w-100" @onclick="EnviarReporteUrbano">Enviar Alerta de Soporte</button>

            @if (!string.IsNullOrEmpty(mensajeAlerta))
            {
                <div class="alert alert-success mt-3 shadow-sm border-0" role="alert">
                    <i class="oi oi-check me-1"></i> @mensajeAlerta
                </div>
            }
            <hr class="my-4" />
            <h6 class="fw-bold mb-3 text-secondary"><i class="oi oi-list me-2"></i> Mis Reportes Recientes (Simulación Local)</h6>

            <div class="table-responsive">
                <table class="table table-hover bg-white rounded shadow-sm overflow-hidden" style="font-size: 12px;">
                    <thead class="table-dark">
                        <tr>
                            <th>Código</th>
                            <th>Estación</th>
                            <th>Sistema</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="badge bg-secondary">INC-8A32F</span></td>
                            <td>Estación Central</td>
                            <td>Metropolitano</td>
                            <td><span class="badge bg-warning text-dark">En Revisión</span></td>
                        </tr>
                        <tr>
                            <td><span class="badge bg-secondary">INC-4B110</span></td>
                            <td>Estación Angamos</td>
                            <td>Línea 1</td>
                            <td><span class="badge bg-success">Resuelto</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private TransitIssueDto issue = new();
    private string mensajeAlerta = string.Empty;

    private async Task EnviarReporteUrbano()
    {
        if (string.IsNullOrWhiteSpace(issue.CardNumber) || string.IsNullOrWhiteSpace(issue.Description))
        {
            mensajeAlerta = "Por favor, complete los campos obligatorios.";
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/TransitIssue/report", issue);
            if (response.IsSuccessStatusCode)
            {
                mensajeAlerta = $"¡Reporte enviado! Se ha generado tu caso. Estado actual: Asignado a Soporte Técnico.";
                issue = new TransitIssueDto(); // Limpiar formulario
            }
            else
            {
                mensajeAlerta = "Hubo un problema al procesar el reporte en el servidor.";
            }
        }
        catch (Exception)
        {
            // Fallback por si la API local no está corriendo en paralelo en Blazor WASM
            mensajeAlerta = "Alerta capturada localmente. El sistema unificado procesará su caso a la brevedad.";
        }
    }
}