@page "/"
@inject HttpClient Http

<PageTitle>LimaTap · Inicio</PageTitle>

<div class="tab-panel active" id="panel-inicio">
    <div class="ph">
        <div>
            <div class="ph-title">Hola, Carlos 👋</div>
            <div class="ph-sub">@DateTime.Now.ToString("dddd d 'de' MMMM, yyyy") · LimaTap activa</div>
        </div>
        <div style="display:flex;gap:8px">
            <button class="btn btn-outline">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" /><line x1="1" y1="10" x2="23" y2="10" /></svg>
                Tarjeta física
            </button>
            <a href="/recharge" class="btn btn-primary" style="text-decoration:none;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                Recargar
            </a>
        </div>
    </div>

    <div class="inicio-grid">
        <div class="inicio-left">

            <div class="vcard">
                <div class="vcard-strip"></div>
                <div class="vcard-strip2"></div>
                <div style="display:flex;justify-content:space-between;align-items:flex-start;position:relative;z-index:1">
                    <div class="vc-chip"></div>
                    <div style="display:flex;gap:6px;align-items:center">
                        <div class="vc-nfc">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0" /><path d="M1.42 9a16 16 0 0 1 21.16 0" /><path d="M8.53 16.11a6 6 0 0 1 6.95 0" /><line x1="12" y1="20" x2="12.01" y2="20" stroke-width="3" /></svg>
                        </div>
                        <div style="background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:20px;padding:3px 9px;font-size:9px;font-weight:700;color:rgba(255,255,255,.8);letter-spacing:.5px">★ NIVEL ORO</div>
                    </div>
                </div>
                <div class="vc-top-row" style="margin-top:1.1rem">
                    <div>
                        <div class="vc-label">Saldo disponible</div>
                        <div class="vc-balance">S/ @Math.Floor(CurrentBalance)<span class="vc-soles">.@((CurrentBalance % 1).ToString("0.00").Substring(2))</span></div>
                    </div>
                </div>
                <div class="vc-bottom">
                    <div>
                        <div style="font-size:9px;color:rgba(255,255,255,.3);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:3px">LimaTap</div>
                        <div class="vc-num">•••• •••• •••• 7823</div>
                    </div>
                    <div class="vc-tags">
                        <div class="vc-tag vct-met">Metropolitano</div>
                        <div class="vc-tag vct-l1">Línea 1</div>
                    </div>
                </div>
            </div>

            <div>
                <div class="sec-label">Acciones rápidas</div>
                <div class="qa-grid">
                    <a href="/recharge" class="qa-btn" style="text-decoration:none;">
                        <div class="qa-ico" style="background:var(--met-light)">
                            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--met)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="16" /><line x1="8" y1="12" x2="16" y2="12" /></svg>
                        </div>
                        <div class="qa-lbl">Recargar</div>
                    </a>
                    <div class="qa-btn">
                        <div class="qa-ico" style="background:var(--l1-light)">
                            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--l1)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 3 21 3 21 8" /><line x1="4" y1="20" x2="21" y2="3" /><polyline points="21 16 21 21 16 21" /><line x1="15" y1="15" x2="21" y2="21" /></svg>
                        </div>
                        <div class="qa-lbl">Transferir</div>
                    </div>
                    <a href="/validate-tap" class="qa-btn" style="text-decoration:none;">
                        <div class="qa-ico" style="background:rgba(16, 185, 129, 0.12)">
                            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--l2-dark)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                        </div>
                        <div class="qa-lbl">Validar viaje</div>
                    </a>
                    <div class="qa-btn">
                        <div class="qa-ico" style="background:var(--l2-light)">
                            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--l2-dark)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M9 9h6M9 13h4" /></svg>
                        </div>
                        <div class="qa-lbl">Código QR</div>
                    </div>
                    <div class="qa-btn">
                        <div class="qa-ico" style="background:var(--bg3)">
                            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--text2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                        </div>
                        <div class="qa-lbl">Bloquear</div>
                    </div>
                </div>
            </div>

            <div>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
                    <div class="sec-label" style="margin-bottom:0">Últimos movimientos</div>
                    <a href="/journeys" style="font-size:12px;color:var(--met);font-weight:600;cursor:pointer;text-decoration:none;">Ver todos →</a>
                </div>
                <div class="txns">
                    <div class="txn">
                        <div class="txn-ico" style="background:var(--met-light)">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--met)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1" /><path d="M16 8h4l3 5v3h-7V8z" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" /></svg>
                        </div>
                        <div class="txn-info">
                            <div class="txn-name">Metropolitano · Naranjal → Central</div>
                            <div class="txn-time"><div class="line-tag lt-met"><div class="line-dot" style="background:var(--met)"></div>Metropolitano</div> · Hoy 07:42</div>
                        </div>
                        <div class="txn-amt amt-neg">-S/ 2.70</div>
                    </div>
                    <div class="txn">
                        <div class="txn-ico" style="background:var(--l1-light)">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--l1)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" /></svg>
                        </div>
                        <div class="txn-info">
                            <div class="txn-name">Línea 1 · Atocongo → San Borja Norte</div>
                            <div class="txn-time"><div class="line-tag lt-l1"><div class="line-dot" style="background:var(--l1)"></div>Línea 1</div> · Hoy 08:15 <span class="badge-transbordo">TRANSBORDO GRATIS</span></div>
                        </div>
                        <div class="txn-amt amt-pos">S/ 0.00</div>
                    </div>
                    <div class="txn">
                        <div class="txn-ico" style="background:var(--l2-light)">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--l2-dark)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" /><line x1="1" y1="10" x2="23" y2="10" /></svg>
                        </div>
                        <div class="txn-info">
                            <div class="txn-name">Recarga de saldo · Yape</div>
                            <div class="txn-time">Ayer, 06:30 PM · Recarga digital</div>
                        </div>
                        <div class="txn-amt amt-pos">+S/ 30.00</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="inicio-right">
            <div>
                <div class="sec-label">Estado del sistema</div>
                <div class="sys-grid">
                    <div class="sys-card" style="border-color:var(--met-mid)">
                        <div class="sys-header">
                            <div class="s-dot" style="background:var(--met)"></div>
                            <div class="sys-name" style="color:var(--met)">Metropolitano</div>
                        </div>
                        <div class="sys-sub">Operativo · 42 buses en servicio</div>
                    </div>
                    <div class="sys-card" style="border-color:var(--l1-mid)">
                        <div class="sys-header">
                            <div class="s-dot" style="background:var(--l1)"></div>
                            <div class="sys-name" style="color:var(--l1)">Línea 1</div>
                        </div>
                        <div class="sys-sub">Operativa · 26 trenes en circulación</div>
                    </div>
                    <div class="sys-card" style="border-color:var(--l2-mid)">
                        <div class="sys-header">
                            <div class="s-dot" style="background:var(--l2);animation:none"></div>
                            <div class="sys-name" style="color:var(--l2-dark)">Línea 2</div>
                        </div>
                        <div class="sys-sub">En construcción · Fase 1 prog. 2027</div>
                    </div>
                </div>
            </div>

            <div>
                <div class="sec-label">Billeteras digitales</div>
                <div class="wallets-row">
                    <div class="w-card">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text2)" stroke-width="1.5"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15v-4H7l5-8v4h4l-5 8z" /></svg>
                        <div class="w-label">Apple Wallet</div>
                        <div class="w-linked">● Vinculada</div>
                    </div>
                    <div class="w-card">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text3)" stroke-width="1.5"><circle cx="12" cy="12" r="10" /><path d="M12 8v8M8 12h8" /></svg>
                        <div class="w-label">Google Wallet</div>
                        <div class="w-unlinked">Vincular ahora</div>
                    </div>
                </div>
            </div>

            <div>
                <div class="sec-label">Resumen del mes</div>
                <div class="mini-stats-grid">
                    <div class="ms-box"><div class="ms-lbl">Viajes</div><div class="ms-val">87</div></div>
                    <div class="ms-box"><div class="ms-lbl">Gasto</div><div class="ms-val">S/ 142</div></div>
                    <div class="ms-box"><div class="ms-lbl">Transbordos</div><div class="ms-val green">14</div></div>
                    <div class="ms-box"><div class="ms-lbl">Ahorro</div><div class="ms-val green">S/ 21</div></div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private decimal CurrentBalance = 42.50m;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<AccountDto>("api/Account/12345");
            if (response != null)
            {
                CurrentBalance = response.Balance;
            }
        }
        catch { /* Usa el saldo inicial de 42.50 si la API no está lista */ }
    }

    public class AccountDto
    {
        public decimal Balance { get; set; }
    }
}