@using System.Globalization
@inject IJSRuntime JS

<div class="qr-container">
    @if (!string.IsNullOrEmpty(Data))
    {
        <div class="qr-display">
            <div @ref="qrElement" id="qr-@InstanceId"></div>
        </div>
    }
    else
    {
        <div class="qr-placeholder">
            <p>Generando código QR...</p>
        </div>
    }
    
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="qr-title">@Title</div>
    }
    
    @if (!string.IsNullOrEmpty(Description))
    {
        <div class="qr-description">@Description</div>
    }
</div>

@code {
    [Parameter]
    public string? Data { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public int Size { get; set; } = 300;

    private ElementReference qrElement;
    private string InstanceId = Guid.NewGuid().ToString().Substring(0, 8);

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Data))
        {
            await GenerateQRCode();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Data))
        {
            await GenerateQRCode();
        }
    }

    private async Task GenerateQRCode()
    {
        try
        {
            await Task.Delay(100); // Pequeño delay para asegurar que el DOM está listo
            
            await JS.InvokeVoidAsync("qrCodeInterop.generateQR", $"qr-{InstanceId}", Data, Size);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al generar QR: {ex.Message}");
        }
    }
}

//diseño de trasnsaccion

<style>
.qr-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    text-align: center;
}

.qr-display {
    padding: 1rem;
    background: white;
    border-radius: 8px;
    border: 2px solid #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.qr-placeholder {
    width: 300px;
    height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
    border-radius: 8px;
    border: 2px dashed #ccc;
    color: #666;
}

.qr-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #333;
    margin-top: 0.5rem;
}

.qr-description {
    font-size: 0.875rem;
    color: #666;
    margin-top: 0.25rem;
}
</style>
